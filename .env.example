# Model Council — example configuration.
#
# Copy to .env for local development. When an MCP client launches the server,
# put these same variables in the client's `env` block instead (see
# examples/claude_desktop_config.json), or point COUNCIL_CONFIG at a JSON file
# (see examples/config.json).

# The roster: short ids, comma separated. Each id gets its own set of variables
# below, named after the id uppercased (my-model -> MY_MODEL_BASE_URL).
# If you omit COUNCIL_MODELS entirely, the roster defaults to `chatgpt,glm`.
COUNCIL_MODELS=gpt5,glm

# ---- an OpenAI-compatible endpoint ----------------------------------------- #
# Works with the OpenAI API itself, or any gateway/relay that speaks the same
# format. base_url is the root that /chat/completions hangs off, usually /v1.
GPT5_BASE_URL=https://your-openai-compatible-host/v1
GPT5_API_KEY=sk-xxxxxxxx
GPT5_MODEL=gpt-5
GPT5_LABEL=GPT-5
# GPT5_FORMAT=openai           # default
# GPT5_TEMPERATURE=0.3         # sent only when set
# GPT5_WEIGHT=2                # how far this member's opinion carries, relative
#                              # to the others. Default 1, max 10, 0 = advisory
#                              # only. Reported with the answers when the
#                              # council's weights differ; never shown to the
#                              # models themselves
# GPT5_TIMEOUT=180             # seconds per attempt; overrides COUNCIL_TIMEOUT
# GPT5_RETRIES=2               # extra attempts after a 429, a 5xx or a dropped
#                              # connection. 0 = report the first failure as final
# GPT5_RETRY_BACKOFF=1         # seconds before the first retry, doubling after
# GPT5_HEADERS={"X-Trace":"council"}   # extra HTTP headers, JSON object
# GPT5_ENABLED=false           # park a member without deleting its config
# GPT5_PROXY=direct            # the route this member takes out, decided for it
#                              # alone. Unset follows HTTP_PROXY/HTTPS_PROXY (or
#                              # COUNCIL_PROXY below); `direct` ignores them, for
#                              # an endpoint a proxy cannot reach such as an
#                              # internal gateway; a URL such as
#                              # http://127.0.0.1:7890 or socks5://127.0.0.1:1080
#                              # sends only this member through that proxy; `env`
#                              # puts it back on the environment's proxy when
#                              # COUNCIL_PROXY has sent everyone else elsewhere.
#                              # list_council prints the effective route
# GPT5_VISION=false            # this model cannot be shown an image. It then sits
#                              # out any call carrying one, rather than answering
#                              # about the text alone as though it had seen it

# ---- an Anthropic-compatible endpoint -------------------------------------- #
# Some providers expose the Anthropic Messages format. Setting the URL alone is
# not enough — you MUST also set _FORMAT=anthropic, or every call will fail.
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_API_KEY=xxxxxxxx
GLM_MODEL=glm-4.6
GLM_FORMAT=anthropic
# GLM_MAX_TOKENS=8192          # required by this format; default 8192
# GLM_CACHE=false              # stop sending the cache_control breakpoint that
#                              # marks `materials` as the reusable prefix. Only
#                              # this format has the field; turn it off for a
#                              # gateway that rejects unknown keys

# ---- optional --------------------------------------------------------------#
# COUNCIL_TIMEOUT=180          # default seconds per attempt, for every member
# COUNCIL_RETRIES=2            # default retries, for every member
# COUNCIL_RETRY_BACKOFF=1      # default first-retry delay in seconds
# COUNCIL_PROXY=direct         # the route every member takes unless it sets its
#                              # own. `direct` sends the whole council past a
#                              # proxy the rest of this machine uses; a URL puts
#                              # the council behind one without touching
#                              # HTTP_PROXY. Any member can still override it
# COUNCIL_CONFIG=~/.config/model-council/config.json   # use a file instead.
#                              # Some things only exist there: shared providers,
#                              # and `backups` — a second and third endpoint for
#                              # one seat, tried in order when the first is out.
#                              # There is no env-var spelling of either
# COUNCIL_MATERIALS_ROOT=/srv/council/material
#                              # the one directory `materials` paths may name.
#                              # Over stdio paths are already allowed and this
#                              # narrows them; over HTTP it is what allows them
#                              # at all — see the README
